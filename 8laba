#include <stdio.h>
#include <math.h>

int main() {
    double x, h, y;
    double a = 2.0, b = 4.0;

    printf("Tabulirovanie funktsii y = 2^x - 2*x^2 - 1\n");
    printf("Interval: [2; 4]\n");
    printf("Vvedite shag tabulirovaniya h: ");
    scanf("%lf", &h);

    if (h <= 0) {
        printf("Oshibka: shag dolzhen byt bolshe 0.\n");
        return 1;
    }

    printf("\n-------------------------\n");
    printf("|   x   |     f(x)       |\n");
    printf("-------------------------\n");

    for (x = a; x <= b + 1e-9; x += h) {
        y = pow(2, x) - 2 * x * x - 1;
        printf("| %5.2f | %13.6f |\n", x, y);
    }

    printf("-------------------------\n");

    return 0;
}
