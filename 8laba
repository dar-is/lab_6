    scanf("%lf %lf", &x, &y);
    if (x >= 0 && y <= 0 &&
        y <= -x && x * x + y * y <= 2) {
        printf("Tochka prinadlezhit oblasti.\n");
    } else {
        printf("Tochka ne prinadlezhit oblasti.\n");
