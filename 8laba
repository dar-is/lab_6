#include <stdio.h>
#include <math.h>

int main(void) {
    int n;
    
    printf("Введите степень n: ");
    scanf("%d", &n);

    if (n < 0 || n > 30) {
        printf("Ошибка: n должно быть от 0 до 30.\n");
        return 1;
    }

    for (int i = 0; i <= n; i++) {
        printf("%2d^%-2d = %10.0f\n", 2, i, pow(2, i));
    }

    double result = pow(2, n) / 1024.0;
    printf("\nРезультат: %.0fK\n", result);

    return 0;
}
