#define _CRT_SECURE_NO_WARNINGS
#include <locale.h>
#include <stdio.h>
#include <stdlib.h>



int main(void)
{
    double x;   // аргумент функции

    /* Контрольные примеры (рассчитаны вручную):
       1) x = 10 (x >= 8):  F = -10*10 + 10 - 9 = -100 + 10 - 9 = -99
       2) x = 2  (x < 8):   F = 1 / (2^4 - 6) = 1 / 10 = 0.1
       3) x = 8  (граница): F = -64 + 8 - 9 = -65
    */

    // Приглашение к вводу и ввод x
    printf("Введите x: ");
    scanf("%lf", &x);

    /* Вычисление и вывод с помощью тернарной операции в printf:
       если x >= 8, то F = -x^2 + x - 9,
       иначе F = 1 / (x^4 - 6) */
    printf("F(%g) = %g\n", x, x >= 8 ? -x * x + x - 9 : 1 / (x * x * x * x - 6));

    return 0;
}
