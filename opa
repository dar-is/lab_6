#include <stdio.h>

int main() {
    // a. Объявление целой переменной year
    int year;

    // b. Приглашение к вводу года
    printf("Введите год: ");

    // c. Ввод с клавиатуры значения
    scanf("%d", &year);

    // d, e. Вычисление остатка от деления и применение if-else
    if (year % 4 == 0) {
        printf("Год является високосным.\n");
    } else {
        printf("Год не является високосным.\n");
    }

    return 0;
}
