#include <stdio.h>
#include <math.h>

// Функция вычисления a, b, y
void calculate(double p, double x, double *a, double *b, double *y)
{
    *a = sqrt(p * x);
    *b = p * pow(x, 2) + sqrt(*a);
    *y = pow(log(pow(*b, 2)), 3) + (*a) * x;
}

// Функция проверки условий
void check_conditions(int A, int B, int C)
{
    int usl_a, usl_b;

    // а) только одно из чисел A и B чётное
    usl_a = (A % 2 == 0) != (B % 2 == 0);

    // б) каждое из чисел A, B, C кратно трём
    usl_b = (A % 3 == 0) && (B % 3 == 0) && (C % 3 == 0);

    printf("Условие а) выполнено (1 - да, 0 - нет): %d\n", usl_a);
    printf("Условие б) выполнено (1 - да, 0 - нет): %d\n", usl_b);
}

int main(void)
{
    double a, b, y;
    int A, B, C;

    // Данные из задания №5
    double p = 3;
    double x = 4.1;

    // Вычисление a, b, y
    calculate(p, x, &a, &b, &y);

    printf("a = %lf, b = %lf, y = %lf\n", a, b, y);

    // Целая часть
    A = (int)a;
    B = (int)b;
    C = (int)y;

    printf("A = %d, B = %d, C = %d\n", A, B, C);

    // Проверка условий
    check_conditions(A, B, C);

    return 0;
}
