#define _CRT_SECURE_NO_DEPRECATE
#include<stdio.h>
#include<locale.h>
#include<math.h>

double calculate(double x)
{
    return x <= 7 ? -3 * x + 9 : 1 / (x - 7);
}

int main(void)
{
    setlocale(LC_ALL, "RUS");

    double x;

    //
    //   Контрольные примеры:
    //
    //   1) x = 5 (x <= 7):
    //     F(5) = -3 * 5 + 9 = -6
    //
    //   2) x = 8 (x > 7):
    //     F(8) = 1 / (8 - 7) = 1
    //

    printf("Введите x: ");
    scanf("%lf", &x);

    printf("F(%g) = %g\n", x, calculate(x));

    system("pause");
}

