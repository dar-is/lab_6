#define _USE_MATH_DEFINES 
#include<stdio.h>
#include<locale.h>
#include<math.h>

void check_conditions(int A, int B, int C)
{
    int usl_a, usl_b;
    usl_a = (A % 2 == 0) != (B % 2 == 0);
    usl_b = (A % 3 == 0) && (B % 3 == 0) && (C % 3 == 0);

    printf("Условие а) выполнено (1 - да, 0 - нет): %d\n", usl_a);
    printf("Условие б) выполнено (1 - да, 0 - нет): %d\n", usl_b);
}

int main(void)
{
    setlocale(LC_ALL, "RUS");

    double a, b, y;
    int A, B, C;
    int usl_a, usl_b;

    int p = 3;
    double x = 4.1;

    a = sqrt(p * x);
    b = p * pow(x, 2) + sqrt(a);
    y = pow(log(pow(b, 2)), 3) + a * x;

    printf("a = %lf, b = %lf, y = %lf\n", a, b, y);

    A = (int)a;
    B = (int)b;
    C = (int)y;

    printf("A = %d, B = %d, C = %d\n", A, B, C);

    check_conditions(A, B, C);

    system("pause");
}

