#define _CRT_SECURE_NO_WARNINGS
#include <stdio.h>
#include <locale.h>
#include <stdlib.h>

int proverkaChet(int A, int B)
{
    if ((A % 2 == 0 && B % 2 != 0) ||
        (A % 2 != 0 && B % 2 == 0))
    {
        return 1;
    }
    else
    {
        return 0;
    }
}

int proverkaKratnost(int A, int B, int C)
{
    if (A % 3 == 0 && B % 3 == 0 && C % 3 == 0)
    {
        return 1;
    }
    else
    {
        return 0;
    }
}

int main(void)
{
    setlocale(LC_ALL, "RUS");

    int A, B, C;
    int usl_a, usl_b;

    printf("========Введите A, B, C=========== ");
    scanf("%d %d %d", &A, &B, &C);

    usl_a = proverkaChet(A, B);

    usl_b = proverkaKratnost(A, B, C);

    printf("условие а) выполнено (1 - да, 0 - нет): %d\n", usl_a);
    printf("условие б) выполнено (1 - да, 0 - нет): %d\n", usl_b);


    system("pause");
}
